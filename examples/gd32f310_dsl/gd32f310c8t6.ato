module AdcInputFilter:
    # 3.3 kOhm series resistor, 100 nF shunt capacitor, source-side test pad.

module AdcFilterBank:
    # ADC_IN0: TPADC0 -> RAD0 -> CAD0 -> ADC0_FILT
    # ADC_IN1: TPADC1 -> RAD1 -> CAD1 -> ADC1_FILT
    # ADC_IN2: TPADC2 -> RAD2 -> CAD2 -> ADC2_FILT
    # ADC_IN3: TPADC3 -> RAD3 -> CAD3 -> ADC3_FILT
