(export (version D)
  (design
    (source injector_2channel.ato)
    (date "2025-12-22")
    (tool "Pardal PCB")
    (comment "2-Channel Car Injector Controller - Simplified"))
  (components
    (comp (ref Q1)
      (value IRLZ44N)
      (footprint Package_TO_SOT_THT:TO-220-3_Vertical)
      (description "N-MOSFET Channel 1"))
    (comp (ref Q2)
      (value IRLZ44N)
      (footprint Package_TO_SOT_THT:TO-220-3_Vertical)
      (description "N-MOSFET Channel 2"))
    (comp (ref R1)
      (value 220)
      (footprint Resistor_SMD:R_0805_2012Metric)
      (description "Gate resistor CH1"))
    (comp (ref R2)
      (value 220)
      (footprint Resistor_SMD:R_0805_2012Metric)
      (description "Gate resistor CH2"))
    (comp (ref R3)
      (value 10k)
      (footprint Resistor_SMD:R_0805_2012Metric)
      (description "Pulldown CH1"))
    (comp (ref R4)
      (value 10k)
      (footprint Resistor_SMD:R_0805_2012Metric)
      (description "Pulldown CH2"))
    (comp (ref D1)
      (value 1N4007)
      (footprint Diode_THT:D_DO-41_SOD81_P10.16mm_Horizontal)
      (description "Flyback diode CH1"))
    (comp (ref D2)
      (value 1N4007)
      (footprint Diode_THT:D_DO-41_SOD81_P10.16mm_Horizontal)
      (description "Flyback diode CH2"))
    (comp (ref C1)
      (value 100uF)
      (footprint Capacitor_THT:CP_Radial_D6.3mm_P2.50mm)
      (description "Bulk capacitor"))
    (comp (ref C2)
      (value 100nF)
      (footprint Capacitor_SMD:C_0805_2012Metric)
      (description "Logic bypass cap"))
    (comp (ref J1)
      (value POWER)
      (footprint Connector_PinHeader_2.54mm:PinHeader_1x03_P2.54mm_Vertical)
      (description "Power connector"))
    (comp (ref J2)
      (value CONTROL)
      (footprint Connector_PinHeader_2.54mm:PinHeader_1x03_P2.54mm_Vertical)
      (description "Control signals"))
    (comp (ref J3)
      (value INJECTORS)
      (footprint Connector_PinHeader_2.54mm:PinHeader_1x03_P2.54mm_Vertical)
      (description "Injector outputs")))
  (nets
    (net (code 1) (name GND)
      (node (ref J1) (pin 3))
      (node (ref J2) (pin 3))
      (node (ref Q1) (pin 2))
      (node (ref Q2) (pin 2))
      (node (ref R3) (pin 2))
      (node (ref R4) (pin 2))
      (node (ref C1) (pin 2))
      (node (ref C2) (pin 2)))
    (net (code 2) (name +12V)
      (node (ref J1) (pin 1))
      (node (ref D1) (pin 1))
      (node (ref D2) (pin 1))
      (node (ref C1) (pin 1)))
    (net (code 3) (name +5V)
      (node (ref J1) (pin 2))
      (node (ref C2) (pin 1)))
    (net (code 4) (name IN1)
      (node (ref J2) (pin 1))
      (node (ref R1) (pin 1)))
    (net (code 5) (name IN2)
      (node (ref J2) (pin 2))
      (node (ref R2) (pin 1)))
    (net (code 6) (name GATE1)
      (node (ref R1) (pin 2))
      (node (ref Q1) (pin 1))
      (node (ref R3) (pin 1)))
    (net (code 7) (name GATE2)
      (node (ref R2) (pin 2))
      (node (ref Q2) (pin 1))
      (node (ref R4) (pin 1)))
    (net (code 8) (name OUT1)
      (node (ref Q1) (pin 3))
      (node (ref D1) (pin 2))
      (node (ref J3) (pin 1)))
    (net (code 9) (name OUT2)
      (node (ref Q2) (pin 3))
      (node (ref D2) (pin 2))
      (node (ref J3) (pin 2)))))
