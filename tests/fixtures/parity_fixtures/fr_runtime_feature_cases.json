{
  "suite": {
    "allow_unpinned_mojo_cfg": true,
    "kicad_drc_timeout_s": 300.0,
    "no_cache": true
  },
  "defaults": {
    "freerouting_capture_stderr": true,
    "freerouting_capture_stdout": true,
    "freerouting_enable_logging": true,
    "freerouting_java_image": "eclipse-temurin:25-jre",
    "freerouting_log_level": "INFO",
    "freerouting_seed": 1,
    "freerouting_trace_jsonl": "off",
    "freerouting_trace_max_events": 300000,
    "freerouting_use_local_jar": "freerouting/build/libs/freerouting-executable.jar"
  },
  "cases": [
    {
      "name": "issue180_core",
      "pcb": "freerouting/tests/Issue180-Test/Test.kicad_pcb",
      "freerouting_max_passes": 50,
      "freerouting_job_timeout": "00:05:00",
      "mojo_cfg": "tests/fixtures/parity_fixtures/mojo_cfgs/issue180_core_pinned.json",
      "mojo_resolution": 0.1,
      "normalize_footprint_libs": true,
      "freerouting_trace_jsonl": "off"
    },
    {
      "name": "fpga_small_core",
      "pcb": "examples/fpga/fpga_unrouted.kicad_pcb",
      "freerouting_max_passes": 5,
      "freerouting_job_timeout": "00:02:00",
