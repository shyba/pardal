      "mojo_resolution": 0.2,
      "freerouting_trace_jsonl": "off"
    },
    {
      "name": "issue269_power_planes_core",
      "pcb": "freerouting/tests/Issue269-NoViasOnPowerPlanes/Issue269-NoViasOnPowerPlanes.kicad_pcb",
      "freerouting_max_passes": 5,
      "freerouting_job_timeout": "00:05:00",
      "mojo_cfg": "tests/fixtures/parity_fixtures/mojo_cfgs/issue269_strict_parity.json",
      "mojo_resolution": 0.2,
      "freerouting_trace_jsonl": "auto",
      "freerouting_trace_nets": "+3V3,GNDREF,/FPGA_DONE"
    },
    {
      "name": "Issue269_min_fr_test",
